<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <!-- Background circle -->
  <circle cx="16" cy="16" r="15" fill="#2563eb" stroke="#1e40af" stroke-width="1"/>
  
  <!-- Shield shape -->
  <path d="M16 4 L8 8 L8 16 C8 20 12 24 16 26 C20 24 24 20 24 16 L24 8 Z" 
        fill="#ffffff" stroke="#1e40af" stroke-width="0.5"/>
  
  <!-- Checkmark inside shield -->
  <path d="M11 16 L14 19 L21 12" 
        stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  
  <!-- Small "JS" text -->
